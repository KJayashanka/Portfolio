PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# SMTP settings for sending contact form emails.
# For Gmail: use smtp.gmail.com, port 587, secure=false, and a 16-character App Password
# (not your normal Gmail password) generated at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Where contact form messages get delivered
CONTACT_RECEIVER=kanishka.jayashanka1@gmail.com
